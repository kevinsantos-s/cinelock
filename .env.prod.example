# Variáveis do docker-compose.prod.yml.
# Na VPS:  cp .env.prod.example .env  e preencha com valores reais.
# O .env NÃO vai pro Git (já está no .gitignore). Nunca comite senha de verdade.

# Banco de dados. Troque a senha por algo forte (ex.: openssl rand -hex 24).
POSTGRES_USER=cinelock
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=cinelock

# URL pública da API — o front é buildado com esse valor embutido no JS.
VITE_API_URL=https://api.cinelock.dev
