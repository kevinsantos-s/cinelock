generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          String    @id @default(uuid())
  tmdbId      Int       @unique
  title       String
  duration    Int // minutos
  synopsis    String
  tagline     String?
  posterUrl   String?
  backdropUrl String?
  genre       String // gêneros em pt-BR, separados por vírgula
  rating      String // classificação indicativa BR ("L", "10", "12", "14", "16", "18")
  year        Int
  voteAverage Float
  sessions    Session[]
}

model Session {
  id           String        @id @default(uuid())
  movieId      String
  movie        Movie         @relation(fields: [movieId], references: [id])
  roomId       String
  startsAt     DateTime
  reservations Reservation[]

  @@index([startsAt])
}

model Reservation {
  id        String            @id @default(uuid())
  sessionId String
  session   Session           @relation(fields: [sessionId], references: [id])
  seat      String // "A5"
  clientId  String // MVP sem login: id gerado no browser
  status    ReservationStatus
  createdAt DateTime          @default(now())
  expiresAt DateTime

  @@unique([sessionId, seat, status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
}
