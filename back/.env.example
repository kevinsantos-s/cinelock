# Copie para .env. No modo Docker completo, as URLs são sobrescritas pelo
# docker-compose.full.yml (postgres:5432, redis:6379, kafka:29092) — estes
# valores aqui são pro desenvolvimento local.
DATABASE_URL=postgresql://cinelock:cinelock@localhost:5432/cinelock
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
PORT=3000

# OPCIONAL. O catálogo já vem congelado em prisma/movies.json — o seed funciona
# sem token. Isto só é preciso pra ATUALIZAR o snapshot (npm run refresh-movies).
# Gere o seu (grátis) em https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=
